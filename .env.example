PORT=6030

# OpenAI
OPENAI_API_KEY=

# Instruction Loading Methods (choose one):
# Method 1: Direct environment variable (highest priority)
OPENAI_INSTRUCTIONS="You are a helpful assistant that can answer questions and help with tasks."

# Method 2: Web service (medium priority) - uncomment to use
#OPENAI_URL_INSTRUCTIONS="https://your-api.com/instructions"

# Method 3: Local file (lowest priority) - uncomment to use
#OPENAI_FILE_INSTRUCTIONS="./instructions.txt"

# Optional OpenAI settings
#OPENAI_TEMPERATURE=0.8
#OPENAI_MAX_TOKENS=100

# Real-Time Interruption Configuration
# =====================================
# Interruptions are ALWAYS ENABLED by default for best user experience.
# This provides real-time barge-in capability where the AI immediately stops
# speaking and cancels ongoing generation when the user begins speaking or 
# sends text input.
#
# Key features:
# - Policy: immediate_cancel (stops TTS and cancels generation immediately)
# - Latency targets: ≤150ms for audio interrupts, ≤100ms for text interrupts
# - No configuration needed - works out of the box
# - Interruptions work from session start (including during greetings)
#
# Technical details:
# - Server-side VAD (Voice Activity Detection) triggers interruption on speech
# - response.cancel sent to OpenAI to stop generation
# - Audio buffers cleared to prevent overlapping speech
# - Interrupted messages marked with status flag for transparency
# - Comprehensive telemetry for monitoring (interrupt.started, interrupt.completed, etc.)
#
# Note: This behavior cannot be disabled. It's a core feature designed to provide
# natural, responsive conversation flow.
